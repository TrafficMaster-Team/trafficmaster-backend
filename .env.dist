POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DRIVER=asyncpg
POSTGRES_DB=trafficmaster

DB_POOL_PRE_PING=True
DB_POOL_RECYCLE=3600
DB_POOL_SIZE=50
DB_POOL_MAX_OVERFLOW=25
DB_ECHO=False
DB_AUTO_FLUSH=False
DB_EXPIRE_ON_COMMIT=False
DB_DEBUG=True
DB_FUTURE=True

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_CACHE_DB=0
REDIS_MAX_CONNECTIONS=20

JWT_SECRET=REPLACE_THIS_WITH_YOUR_OWN_SECRET_VALUE
JWT_ALGORITHM=HS256
PEPPER=REPLACE_THIS_WITH_YOUR_OWN_SECRET_PEPPER_VALUE
SESSION_TTL_MIN=5
SESSION_REFRESH_THRESHOLD=0.2
SECURE=0
COOKIE_SAME_SITE=strict

UVICORN_HOST=0.0.0.0
UVICORN_PORT=8080
FASTAPI_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000
